1.1 CHARACTER COUNT

SOURCE CODE:
#include <stdio.h>
#include <string.h>

int main() {
    char data[100];
    int frame_size;
    int i, j, k;
    int current_pos = 0;

    printf("Enter the data string: ");
    scanf("%s", data);

    printf("Enter the desired frame size: ");
    scanf("%d", &frame_size);
     printf("\n The Total number of chars are :%d ",strlen(data));
  
    printf("\nTransmitted Frames:\n");
    while (current_pos < strlen(data)) {
        int actual_frame_len = 0;
        // Calculate the actual frame length, ensuring it doesn't exceed the data string
        if ((strlen(data) - current_pos) < frame_size) {
            actual_frame_len = strlen(data) - current_pos;
        } else {
            actual_frame_len = frame_size;
        }

        // Print the character count for the current frame
        printf("%d ", actual_frame_len);

        // Print the characters of the current frame
        for (k = 0; k < actual_frame_len; k++) {
            printf("%c", data[current_pos + k]);
        }
        printf("\n"); // New line for the next frame
        current_pos += actual_frame_len;
    }
    return 0;
}

