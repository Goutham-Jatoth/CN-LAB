#include<stdio.h>
int dist[50][50],temp[50][50],n,i,j,k,x;
void dvr(); 
int main() 
{
	printf("\nEnter the number of nodes : ");
 	scanf("%d",&n);
 	printf("\nEnter the distance matrix :\n");
 	for(i=0;i<n;i++)
 	{ 
		for(j=0;j<n;j++) 
		{ 
			printf("Enter cost of %d-%d: ",i+1,j+1);
			scanf("%d",&dist[i][j]);
 			dist[i][i]=0;
 			temp[i][j]=j;
 		} 
		printf("\n");
 	} 
	dvr(); 
	printf("To update further enter nodes numbers: ");
 	scanf("%d",&i); 
	scanf("%d",&j);
 	printf("After update\n\n");
 	dvr();
 	return 0;
}
void dvr() 
{ 
	for (i = 0; i < n; i++)
	for (j = 0; j < n; j++) 
	for (k = 0; k < n; k++)
 	if (dist[i][k] + dist[k][j] < dist[i][j])
 	{ 
		dist[i][j] = dist[i][k] + dist[k][j];
 		temp[i][j] = k;
 	}
 	for(i=0;i<n;i++)
 	{
 		printf("\n\nRouting Table for Router:: %d is \n",i+1);
 		printf("To\tCost\tNext\n");
 		for(j=0;j<n;j++) 
		{
 			if ((temp[i][j]+1)==(j+1))
 			printf("\n%d\t %d\t --",j+1,dist[i][j]); 
			else 
			printf("\n%d\t %d\t %d",j+1,dist[i][j],temp[i][j]+1); 
		}
 	}
	        printf("\n\n");
 }
