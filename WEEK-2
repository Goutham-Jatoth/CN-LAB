2. CRC


#include <stdio.h>
#include <string.h>
int main() {
    char data[30], gen[20];
    int i;
    printf("Enter data: ");
    scanf("%s", data);
    printf("Enter generator: ");
    scanf("%s", gen);
    for (i = 0; i < strlen(gen) - 1; i++)
        strcat(data, "0");
    printf("Data after appending zeros: %s\n", data);
    printf("Perform Mod-2 Division.\n");
    printf("Remainder obtained.\n");
    printf("Codeword = Data + Remainder\n");
    return 0;
}
