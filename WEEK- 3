3. Develop a simple data link layer that performs the flow control using the sliding window protocol, and loss recovery using the Go-Back-N mechaniem. In cn lab 

Source Code:-

#include <stdio.h>
int main()
{
    int frames, windowsize, ack = 0, i;
    printf("Enter no. of frames:\n");
    scanf("%d", &frames);
    printf("Enter window size:\n");
    scanf("%d", &windowsize);
left:
    while (ack < frames)
    {
        for (i = ack; i < windowsize + ack && i < frames; i++)
        {
            printf("Frame %d has been transmitted\n", i);
        }
        printf("Please enter the acknowledgement now: ");
        scanf("%d", &ack);
        if (ack > i)
        {
            if (ack == frames)
            {
                printf("Total frames were sent.\n");
            }
            else
            {
                printf("Invalid acknowledgement. Resending frames.\n");
                ack = i - windowsize;
            }
        }
        else if (ack < frames)
        {
            goto left;
        }
        else
        {
            break;
        }
    }
    return 0;
}





